{
    "name": "bestora/laravel-filament-activity-log",
    "description": "Laravel Filament Activity Log",
    "keywords": [
        "bestora",
        "laravel",
        "filament",
        "filament-plugin",
        "activitylog"
    ],
    "homepage": "https://github.com/bestora/laravel-filament-activity-log",
    "license": "MIT",
    "authors": [
        {
            "name": "Dennis Rehbehn",
            "email": "lfal@bestora.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.6",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.9",
        "laravel/pint": "^1.16",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^9.0.0||^11.0",
        "pestphp/pest": "^2.34||^4.4",
        "pestphp/pest-plugin-arch": "^2.7||^4.0",
        "pestphp/pest-plugin-laravel": "^2.3||^4.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bestora\\FilamentActivityLog\\": "src/",
            "Bestora\\FilamentActivityLog\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bestora\\FilamentActivityLog\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-activitylog --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bestora\\FilamentActivityLog\\ActivitylogServiceProvider"
            ],
            "aliases": {
                "Activitylog": "Bestora\\FilamentActivityLog\\Facades\\Activitylog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
